# Runtime study data at the repo root only — anchored so vendored fixtures under
# test/fixtures/**/.agent/learning stay committable.
/.agent/

# Secrets / environment
.env
.env.*

# Dependencies (reproducible via package-lock.json; run `npm install`)
node_modules/

# OS metadata
.DS_Store
Thumbs.db

# Runtime logs (generated)
server*.log

# Personal memory (not shipped) — mirrors the pi-agent-harness rule
PROGRESS.md
LESSONS.md

# Design handoff reference (not shipped; PLAN.md still references it locally)
docs/handoff-shots/

# Fixture runtime artifacts — created if a test or a real agent runs inside a fixture.
# Same rule as GL-019: these embed absolute paths and therefore the OS username.
test/fixtures/**/.agent/learning/events.jsonl
test/fixtures/**/.agent/learning/SESSIONS/
# ...except a fixture that deliberately ships a journal, so the reader has something real
# to parse. Runtime artifacts in every OTHER fixture stay ignored.
!test/fixtures/course-with-journal/.agent/learning/SESSIONS/
test/fixtures/**/.agent/learning/telemetry-errors.log
# The registry is runtime state too — a test that registers a course must not dirty a fixture.
test/fixtures/**/.agent/courses.json
test/fixtures/**/.agent/telemetry*

# Frontend build output (run `npm run build`)
web/dist/
